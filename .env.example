# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/rental_db_name?schema=public"

# Authentication
JWT_SECRET="your_super_secret_jwt_key_here"

# Razorpay UPI Payment Gateway
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"

# Pusher Real-Time Chat Config
PUSHER_APP_ID="your_pusher_app_id"
PUSHER_KEY="your_pusher_key"
PUSHER_SECRET="your_pusher_secret"
PUSHER_CLUSTER="ap2"

# Firebase Cloud Messaging (FCM) Config for Android Push Notifications
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-firebase-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour\nPrivate\nKey\nHere\n-----END PRIVATE KEY-----\n"